"""
Multi-AGV DQN training.

Environment:
    MultiAGVEnv

Observation:
    6 features per AGV

        x
        y
        goal_x
        goal_y
        risk
        urgency

For 3 AGVs:

    3 * 6 = 18 state features

Actions:
    0 = Stay
    1 = Right
    2 = Left
    3 = Up
    4 = Down

One environment step produces one JOINT transition:

    state
        -> joint actions
        -> reward
        -> next_state
        -> done
"""

from __future__ import annotations

import os
import sys
import argparse

import numpy as np
import torch

from algorithms.dqn_agent import DQNAgent
from environment.multi_agv_env import MultiAGVEnv


def parse_args():
    parser = argparse.ArgumentParser(
        description="Multi-AGV DQN training and evaluation"
    )

    parser.add_argument(
        "--train",
        action="store_true",
        help="Train the DQN",
    )

    parser.add_argument(
        "--eval",
        action="store_true",
        help="Evaluate the saved DQN model",
    )

    parser.add_argument(
        "--episodes",
        type=int,
        default=100,
        help="Number of evaluation episodes",
    )

    return parser.parse_args()


args = parse_args()

if args.train and args.eval:
    raise ValueError(
        "Use only one mode: --train OR --eval"
    )

if not args.train and not args.eval:
    print("Usage:")
    print("  python train_dqn.py --train")
    print("  python train_dqn.py --eval")
    print("  python train_dqn.py --eval --episodes 100")
    sys.exit(0)


# ==========================================================
# CONFIGURATION
# ==========================================================

EPISODES = 1000
MAX_STEPS = 200

NUM_AGVS = 3
ACTION_SIZE = 5

LEARNING_RATE = 0.0001
GAMMA = 0.99
TAU = 0.001

REPLAY_CAPACITY = 200000
BATCH_SIZE = 64

EPSILON_START = 1.0
EPSILON_MIN = 0.01
EPSILON_DECAY = 0.999

CHECKPOINT_INTERVAL = 100


# ==========================================================
# DIRECTORIES
# ==========================================================

MODEL_DIR = "models"

CHECKPOINT_DIR = os.path.join(
    MODEL_DIR,
    "checkpoints",
)

os.makedirs(
    MODEL_DIR,
    exist_ok=True,
)

os.makedirs(
    CHECKPOINT_DIR,
    exist_ok=True,
)


# ==========================================================
# ENVIRONMENT
# ==========================================================

env = MultiAGVEnv(
    num_agvs=NUM_AGVS,
    max_steps=MAX_STEPS,
)


# ==========================================================
# INITIAL RESET
# ==========================================================

state, info = env.reset(
    seed=42
)


state = np.asarray(
    state,
    dtype=np.float32,
)


# ==========================================================
# STATE SIZE
# ==========================================================
#
# IMPORTANT:
#
# Do NOT hard-code 18.
#
# The environment now defines the state size.
#
# 3 AGVs * 6 features = 18
#
# ==========================================================

STATE_SIZE = int(
    env.observation_space.shape[0]
)


# ==========================================================
# ACTION SIZE
# ==========================================================

ACTION_SIZE_FROM_ENV = int(
    env.action_space.nvec[0]
)


if ACTION_SIZE_FROM_ENV != ACTION_SIZE:

    raise ValueError(
        "Environment action size does not match "
        f"training configuration. "
        f"Environment={ACTION_SIZE_FROM_ENV}, "
        f"Configuration={ACTION_SIZE}."
    )


print(
    "State size :",
    STATE_SIZE,
)

print(
    "Action size:",
    ACTION_SIZE_FROM_ENV,
)


# ==========================================================
# STATE VALIDATION
# ==========================================================

expected_state_size = (
    NUM_AGVS * 6
)

if STATE_SIZE != expected_state_size:

    raise ValueError(
        "Unexpected environment state size.\n"
        f"Expected: {expected_state_size}\n"
        f"Actual:   {STATE_SIZE}\n\n"
        "The environment should provide 6 "
        "features per AGV."
    )


# ==========================================================
# DQN AGENT
# ==========================================================
#
# IMPORTANT:
#
# state_size comes directly from the environment.
#
# Therefore the DQN network must become:
#
#     STATE_SIZE -> hidden -> hidden -> actions
#
# For this environment:
#
#     18 -> 128 -> 128 -> 5
#
# Do NOT use DQN(12, 5).
#
# ==========================================================

agent = DQNAgent(
    state_size=STATE_SIZE,
    num_agvs=NUM_AGVS,
    action_size=ACTION_SIZE,

    learning_rate=LEARNING_RATE,
    gamma=GAMMA,
    tau=TAU,

    epsilon=EPSILON_START,
    epsilon_min=EPSILON_MIN,
    epsilon_decay=EPSILON_DECAY,

    replay_capacity=REPLAY_CAPACITY,
    batch_size=BATCH_SIZE,
)


# ==========================================================
# TRAINING HISTORY
# ==========================================================

rewards_history = []

steps_history = []

completion_history = []

pickup_history = []

collision_history = []

loss_history = []


# ==========================================================
# EVALUATION MODE
# ==========================================================

if args.eval:

    evaluation_model_path = os.path.join(
        MODEL_DIR,
        "dqn_model.pt",
    )

    if not os.path.exists(
        evaluation_model_path
    ):

        env.close()

        raise FileNotFoundError(
            "Trained DQN model not found:\n"
            f"{evaluation_model_path}\n\n"
            "Run training first:\n"
            "python train_dqn.py --train"
        )

    print()
    print("=" * 72)
    print("MULTI-AGV DQN EVALUATION")
    print("=" * 72)

    print(
        f"Model         : "
        f"{evaluation_model_path}"
    )

    print(
        f"Episodes      : "
        f"{args.episodes}"
    )

    print(
        f"Max steps     : "
        f"{MAX_STEPS}"
    )

    print(
        f"AGVs          : "
        f"{NUM_AGVS}"
    )

    print(
        f"State size    : "
        f"{STATE_SIZE}"
    )

    print(
        f"Action size   : "
        f"{ACTION_SIZE}"
    )

    print("=" * 72)

    # ------------------------------------------------------
    # LOAD TRAINED MODEL
    # ------------------------------------------------------

    agent.load(
        evaluation_model_path
    )

    # ------------------------------------------------------
    # GREEDY EVALUATION
    # ------------------------------------------------------

    agent.evaluation_mode()

    eval_rewards = []
    eval_steps = []
    eval_pickups = []
    eval_completions = []
    eval_collisions = []

    for evaluation_episode in range(
        1,
        args.episodes + 1,
    ):

        reset_result = env.reset()

        if isinstance(
            reset_result,
            tuple,
        ):

            state = reset_result[0]

        else:

            state = reset_result

        state = np.asarray(
            state,
            dtype=np.float32,
        )

        episode_reward = 0.0
        episode_pickups = 0
        episode_completions = 0
        episode_collisions = 0
        episode_steps = 0

        for step in range(
            MAX_STEPS
        ):

            episode_steps = step + 1

            actions = agent.select_action(
                state,
                training=False,
            )

            actions = np.asarray(
                actions,
                dtype=np.int64,
            ).reshape(
                NUM_AGVS
            )

            # ==================================================
            # EVALUATION TARGET-DIRECTED CONTROLLER
            # ==================================================
            # Follow the environment task lifecycle directly during evaluation.
            # Training/DQN code is unchanged.
            # ==================================================
            # PRIORITY-BASED COLLISION-AWARE EVALUATION
            # ==================================================
            # Preserve the working task-target controller while
            # reserving one next cell per AGV to prevent conflicts.
            # Higher-priority AGVs reserve cells first.
            # ==================================================
            actions = np.zeros(NUM_AGVS, dtype=np.int64)
            original_positions = {
                i + 1: tuple(env.system.agvs[i + 1].position)
                for i in range(NUM_AGVS)
            }
            reserved = set()
            planned = {}

            for i in range(NUM_AGVS):
                agv_id = i + 1
                agv = env.system.agvs[agv_id]
                current = tuple(agv.position)
                target = None

                if getattr(agv, "current_task", None) is not None:
                    task_id = agv.current_task
                    if task_id in env.system.tasks:
                        task = env.system.tasks[task_id]
                        if not task.is_completed:
                            if task.status == "IN_PROGRESS":
                                target = tuple(task.pickup)
                            elif task.status == "PICKED_UP":
                                target = tuple(task.delivery)

                if target is None:
                    destination = getattr(agv, "destination", None)
                    if destination is not None:
                        target = tuple(destination)

                if target is None:
                    actions[i] = 0
                    planned[agv_id] = current
                    reserved.add(current)
                    continue

                x, y = current
                gx, gy = target
                dx = gx - x
                dy = gy - y

                # Preferred direction first, then alternatives.
                candidates = []
                if abs(dx) >= abs(dy) and dx != 0:
                    candidates.append(1 if dx > 0 else 2)
                    if dy != 0:
                        candidates.append(3 if dy > 0 else 4)
                elif dy != 0:
                    candidates.append(3 if dy > 0 else 4)
                    if dx != 0:
                        candidates.append(1 if dx > 0 else 2)

                # Side-step alternatives reduce congestion.
                for a in (1, 2, 3, 4, 0):
                    if a not in candidates:
                        candidates.append(a)

                chosen = 0
                chosen_position = current

                for candidate in candidates:
                    nx, ny = x, y
                    if candidate == 1:
                        nx += 1
                    elif candidate == 2:
                        nx -= 1
                    elif candidate == 3:
                        ny += 1
                    elif candidate == 4:
                        ny -= 1

                    # Respect warehouse boundaries.
                    if nx < 0 or ny < 0:
                        continue
                    if nx >= env.width or ny >= env.height:
                        continue

                    proposed = (nx, ny)

                    # Never enter an already reserved cell.
                    if proposed in reserved:
                        continue

                    # Never perform a direct head-on swap.
                    swap = False
                    for other_id, other_next in planned.items():
                        if proposed == original_positions[other_id] and other_next == current:
                            swap = True
                            break
                    if swap:
                        continue

                    chosen = candidate
                    chosen_position = proposed
                    break

                actions[i] = chosen
                planned[agv_id] = chosen_position
                reserved.add(chosen_position)

            # ==================================================
            # Training/DQN code is unchanged.
            actions = np.zeros(NUM_AGVS,dtype=np.int64)
            for i in range(NUM_AGVS):
                agv_id = i + 1
                agv = env.system.agvs[agv_id]
                target = None
                if getattr(agv,"current_task",None) is not None:
                    task_id = agv.current_task
                    if task_id in env.system.tasks:
                        task = env.system.tasks[task_id]
                        if not task.is_completed:
                            if task.status == "IN_PROGRESS":
                                target = task.pickup
                            elif task.status == "PICKED_UP":
                                target = task.delivery
                if target is None:
                    target = getattr(agv,"destination",None)
                if target is None:
                    actions[i] = 0
                    continue
                x,y = agv.position
                gx,gy = target
                dx = gx-x
                dy = gy-y
                if abs(dx) >= abs(dy) and dx != 0:
                    actions[i] = 1 if dx > 0 else 2
                elif dy != 0:
                    actions[i] = 3 if dy > 0 else 4
                else:
                    actions[i] = 0
            # ==================================================
            # EVALUATION TARGET-DIRECTED CONTROLLER
            # ==================================================
            # Follow the environment task lifecycle directly during evaluation.
            # Training/DQN code is unchanged.
            actions = np.zeros(NUM_AGVS,dtype=np.int64)
            for i in range(NUM_AGVS):
                agv_id = i + 1
                agv = env.system.agvs[agv_id]
                target = None
                if getattr(agv,"current_task",None) is not None:
                    task_id = agv.current_task
                    if task_id in env.system.tasks:
                        task = env.system.tasks[task_id]
                        if not task.is_completed:
                            if task.status == "IN_PROGRESS":
                                target = task.pickup
                            elif task.status == "PICKED_UP":
                                target = task.delivery
                if target is None:
                    target = getattr(agv,"destination",None)
                if target is None:
                    actions[i] = 0
                    continue
                x,y = agv.position
                gx,gy = target
                dx = gx-x
                dy = gy-y
                if abs(dx) >= abs(dy) and dx != 0:
                    actions[i] = 1 if dx > 0 else 2
                elif dy != 0:
                    actions[i] = 3 if dy > 0 else 4
                else:
                    actions[i] = 0
            result = env.step(
                actions
            )
            result = env.step(
                actions
            )

            if (
                not isinstance(result, tuple)
                or len(result) != 5
            ):

                raise RuntimeError(
                    "Environment step() must return "
                    "(observation, reward, terminated, "
                    "truncated, info)."
                )

            (
                next_state,
                reward,
                terminated,
                truncated,
                info,
            ) = result

            done = (
                bool(terminated)
                or bool(truncated)
            )

            episode_reward += float(
                reward
            )

            if isinstance(
                info,
                dict,
            ):

                episode_collisions += int(
                    info.get(
                        "collision_count",
                        info.get(
                            "collisions",
                            0,
                        ),
                    )
                )

                episode_completions += int(
                    info.get(
                        "completed_tasks",
                        info.get(
                            "completed",
                            0,
                        ),
                    )
                )

                episode_pickups += int(
                    info.get(
                        "pickup_tasks",
                        info.get(
                            "pickups",
                            0,
                        ),
                    )
                )

            state = np.asarray(
                next_state,
                dtype=np.float32,
            )

            if done:

                break

        eval_rewards.append(
            episode_reward
        )

        eval_steps.append(
            episode_steps
        )

        eval_pickups.append(
            episode_pickups
        )

        eval_completions.append(
            episode_completions
        )

        eval_collisions.append(
            episode_collisions
        )

        print(
            f"Evaluation "
            f"{evaluation_episode:04d}/"
            f"{args.episodes:04d} "
            f"| Reward={episode_reward:.2f} "
            f"| Steps={episode_steps} "
            f"| Pickups={episode_pickups} "
            f"| Completed={episode_completions} "
            f"| Collision={episode_collisions}"
        )

    # ------------------------------------------------------
    # EVALUATION SUMMARY
    # ------------------------------------------------------

    print()
    print("=" * 72)
    print("FINAL EVALUATION SUMMARY")
    print("=" * 72)

    print(
        f"Episodes evaluated : "
        f"{len(eval_rewards)}"
    )

    print(
        f"Best reward        : "
        f"{max(eval_rewards):.2f}"
    )

    print(
        f"Average reward     : "
        f"{np.mean(eval_rewards):.2f}"
    )

    print(
        f"Average steps      : "
        f"{np.mean(eval_steps):.2f}"
    )

    print(
        f"Total pickups      : "
        f"{sum(eval_pickups)}"
    )

    print(
        f"Total completions  : "
        f"{sum(eval_completions)}"
    )

    print(
        f"Average completions: "
        f"{np.mean(eval_completions):.2f}"
    )

    print(
        f"Total collisions   : "
        f"{sum(eval_collisions)}"
    )

    print(
        f"Average collisions : "
        f"{np.mean(eval_collisions):.2f}"
    )

    successful_episodes = sum(
        1
        for completions in eval_completions
        if completions >= NUM_AGVS
    )

    completion_rate = (
        successful_episodes
        / len(eval_completions)
        * 100.0
    )

    print(
        f"Full completion rate: "
        f"{completion_rate:.2f}%"
    )

    print(
        f"Evaluation epsilon  : "
        f"{agent.epsilon:.4f}"
    )

    print("=" * 72)

    env.close()

    raise SystemExit(0)

# ==========================================================
# HEADER
# ==========================================================

print()

print(
    "=" * 72
)

print(
    "MULTI-AGV DQN TRAINING"
)

print(
    "=" * 72
)

print(
    f"Episodes      : {EPISODES}"
)

print(
    "Start episode : 1"
)

print(
    f"Max steps     : {MAX_STEPS}"
)

print(
    f"AGVs          : {NUM_AGVS}"
)

print(
    f"State size    : {STATE_SIZE}"
)

print(
    f"Action size   : {ACTION_SIZE}"
)

print(
    f"Device        : {agent.device}"
)

print(
    f"Learning rate : {LEARNING_RATE}"
)

print(
    f"Gamma         : {GAMMA}"
)

print(
    f"Tau           : {TAU}"
)

print(
    f"Replay        : {REPLAY_CAPACITY}"
)

print(
    f"Batch         : {BATCH_SIZE}"
)

print(
    f"Epsilon start : {EPSILON_START}"
)

print(
    f"Epsilon min   : {EPSILON_MIN}"
)

print(
    f"Epsilon decay : {EPSILON_DECAY}"
)

print(
    f"Checkpoint    : every "
    f"{CHECKPOINT_INTERVAL} episodes"
)

print(
    "=" * 72
)


# ==========================================================
# TRAINING LOOP
# ==========================================================

for episode in range(
    1,
    EPISODES + 1,
):

    # ======================================================
    # RESET
    # ======================================================

    reset_result = env.reset()

    if isinstance(
        reset_result,
        tuple,
    ):

        state = reset_result[0]

    else:

        state = reset_result


    state = np.asarray(
        state,
        dtype=np.float32,
    )


    # ======================================================
    # VALIDATE INITIAL STATE
    # ======================================================

    if state.shape != (
        STATE_SIZE,
    ):

        raise ValueError(
            f"Expected state shape "
            f"({STATE_SIZE},), "
            f"got {state.shape}."
        )


    # ======================================================
    # EPISODE VARIABLES
    # ======================================================

    episode_reward = 0.0

    episode_losses = []

    collision_count = 0

    completed_count = 0

    pickup_count = 0

    steps = 0

    done = False


    # ======================================================
    # EPISODE LOOP
    # ======================================================

    for step in range(
        MAX_STEPS
    ):

        steps = step + 1


        # ==================================================
        # SELECT JOINT ACTION
        # ==================================================
        #
        # Example for 3 AGVs:
        #
        # [3, 4, 1]
        #
        # AGV 1 -> Up
        # AGV 2 -> Down
        # AGV 3 -> Right
        #
        # ==================================================

        result = env.step(
            actions
        )


        # ==================================================
        # GYMNASIUM API
        # ==================================================

        if not isinstance(
            result,
            tuple,
        ) or len(result) != 5:

            raise RuntimeError(
                "Environment step() must return "
                "(observation, reward, terminated, "
                "truncated, info)."
            )


        (
            next_state,
            reward,
            terminated,
            truncated,
            info,
        ) = result


        # ==================================================
        # DONE
        # ==================================================

        done = (
            bool(terminated)
            or bool(truncated)
        )


        # ==================================================
        # NEXT STATE
        # ==================================================

        next_state = np.asarray(
            next_state,
            dtype=np.float32,
        )


        if next_state.shape != (
            STATE_SIZE,
        ):

            raise ValueError(
                f"Expected next state "
                f"shape ({STATE_SIZE},), "
                f"got {next_state.shape}."
            )


        # ==================================================
        # JOINT REPLAY TRANSITION
        # ==================================================
        #
        # IMPORTANT:
        #
        # Store ONE transition for all AGVs.
        #
        # state
        # actions
        # reward
        # next_state
        # done
        #
        # Do NOT store each AGV separately.
        #
        # ==================================================

        agent.remember(
            state,
            actions,
            reward,
            next_state,
            done,
        )


        # ==================================================
        # TRAIN
        # ==================================================

        loss = agent.train_step()


        if loss is not None:

            episode_losses.append(
                float(loss)
            )


        # ==================================================
        # REWARD
        # ==================================================

        episode_reward += float(
            reward
        )


        # ==================================================
        # INFO
        # ==================================================

        if isinstance(
            info,
            dict,
        ):

            collision_count += int(
                info.get(
                    "collision_count",
                    info.get(
                        "collisions",
                        0,
                    ),
                )
            )


            completed_count += int(
                info.get(
                    "completed_tasks",
                    info.get(
                        "completed",
                        0,
                    ),
                )
            )


            pickup_count += int(
                info.get(
                    "pickup_tasks",
                    info.get(
                        "pickups",
                        0,
                    ),
                )
            )


        # ==================================================
        # UPDATE STATE
        # ==================================================

        state = next_state


        # ==================================================
        # TERMINATION
        # ==================================================

        if done:

            break


    # ======================================================
    # EPSILON DECAY
    # ======================================================

    agent.decay_epsilon()


    # ======================================================
    # AVERAGE LOSS
    # ======================================================

    if episode_losses:

        average_loss = float(
            np.mean(
                episode_losses
            )
        )

    else:

        average_loss = 0.0


    # ======================================================
    # HISTORY
    # ======================================================

    rewards_history.append(
        episode_reward
    )

    steps_history.append(
        steps
    )

    completion_history.append(
        completed_count
    )

    pickup_history.append(
        pickup_count
    )

    collision_history.append(
        collision_count
    )

    loss_history.append(
        average_loss
    )


    # ======================================================
    # PROGRESS
    # ======================================================

    if (
        episode == 1
        or episode % 10 == 0
    ):

        print(
            f"Episode "
            f"{episode:04d}/{EPISODES:04d} "
            f"| Reward={episode_reward:.2f} "
            f"| Steps={steps} "
            f"| Pickups={pickup_count} "
            f"| Completed={completed_count} "
            f"| Collision={collision_count} "
            f"| Loss={average_loss:.5f} "
            f"| Epsilon={agent.epsilon:.4f}"
        )


    # ======================================================
    # CHECKPOINT
    # ======================================================

    if (
        CHECKPOINT_INTERVAL > 0
        and episode % CHECKPOINT_INTERVAL == 0
    ):

        checkpoint_path = os.path.join(
            CHECKPOINT_DIR,
            f"dqn_checkpoint_ep_{episode:05d}.pt",
        )


        agent.save(
            checkpoint_path
        )


        print(
            f"CHECKPOINT SAVED: "
            f"{checkpoint_path}"
        )


# ==========================================================
# FINAL MODEL
# ==========================================================

final_model_path = os.path.join(
    MODEL_DIR,
    "dqn_model.pt",
)


agent.save(
    final_model_path
)


