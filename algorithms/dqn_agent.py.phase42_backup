"""
Deep Q-Network Agent.

Phase 3B:
- epsilon-greedy exploration
- policy network
- target network
- experience replay
- Huber loss



- Adam optimizer
- soft target updates
"""

import random

import numpy as np
import torch
import torch.nn as nn
import torch.optim as optim

from algorithms.dqn_network import DQNNetwork
from algorithms.replay_buffer import ReplayBuffer


class DQNAgent:

    def __init__(
        self,
        state_size: int,
        num_agvs: int,
        action_size: int = 5,
        learning_rate: float = 0.001,
        gamma: float = 0.99,
        tau: float = 0.001,
        epsilon: float = 1.0,
        epsilon_min: float = 0.05,
        epsilon_decay: float = 0.995,
        replay_capacity: int = 200_000,
        batch_size: int = 64,
        seed: int = 42,
    ):

        self.state_size = int(state_size)
        self.num_agvs = int(num_agvs)
        self.action_size = int(action_size)
        # ==================================================
        # Phase 4.2 centralized joint action space
        # ==================================================
        # Example:
        # 3 AGVs x 5 actions = 125 joint actions
        self.joint_action_size = (
            self.action_size ** self.num_agvs
        )

        self.learning_rate = float(
            learning_rate
        )

        self.gamma = float(gamma)
        self.tau = float(tau)

        self.epsilon = float(epsilon)
        self.epsilon_min = float(
            epsilon_min
        )
        self.epsilon_decay = float(
            epsilon_decay
        )

        self.batch_size = int(
            batch_size
        )

        random.seed(seed)
        np.random.seed(seed)
        torch.manual_seed(seed)

        # --------------------------------------------------
        # Device
        # --------------------------------------------------

        self.device = torch.device(
            "cuda"
            if torch.cuda.is_available()
            else "cpu"
        )

        # --------------------------------------------------
        # Policy network
        # --------------------------------------------------

        self.policy_network = DQNNetwork(
            state_size=self.state_size,
            num_agvs=self.num_agvs,
            action_size=self.action_size,
        ).to(self.device)

        # --------------------------------------------------
        # Target network
        # --------------------------------------------------

        self.target_network = DQNNetwork(
            state_size=self.state_size,
            num_agvs=self.num_agvs,
            action_size=self.action_size,
        ).to(self.device)

        self.target_network.load_state_dict(
            self.policy_network.state_dict()
        )

        self.target_network.eval()

        # --------------------------------------------------
        # Optimizer
        # --------------------------------------------------

        self.optimizer = optim.Adam(
            self.policy_network.parameters(),
            lr=self.learning_rate,
        )

        # --------------------------------------------------
        # Huber loss
        # --------------------------------------------------

        self.loss_function = nn.SmoothL1Loss()

        # --------------------------------------------------
        # Replay buffer
        # --------------------------------------------------

        self.replay_buffer = ReplayBuffer(
            capacity=replay_capacity
        )

        self.training_steps = 0
        
        self._evaluation_env = None

    # ======================================================
    # ACTION SELECTION
    # ======================================================



    # ======================================================
    # PHASE 4.2 JOINT ACTION ENCODING
    # ======================================================
    def encode_joint_action(
        self,
        actions,
    ):
        """
        Convert individual AGV actions into one joint index.
        Example:
        [1,2,3] -> index in range(125)
        """
        index = 0
        for action in actions:
            index = (
                index * self.action_size
                + int(action)
            )
        return int(index)
    def decode_joint_action(
        self,
        index,
    ):
        """
        Convert joint action index back to AGV actions.
        Example:
        index -> [agv0, agv1, agv2]
        """
        actions = []
        index = int(index)
        for _ in range(
            self.num_agvs
        ):
            actions.append(
                index % self.action_size
            )
            index //= self.action_size
        actions.reverse()
        return np.asarray(
            actions,
            dtype=np.int64,
        )
    def select_action(
        self,
        state,
        training=True,
    ):
        """
        Phase 4.2 centralized DQN action selection.
        Returns:
            numpy array:
            [agv0_action, agv1_action, agv2_action]
        """
        # ----------------------------------------------
        # Exploration
        # ----------------------------------------------
        if (
            training
            and random.random() < self.epsilon
        ):
            joint_index = np.random.randint(
                0,
                self.joint_action_size,
            )
            return self.decode_joint_action(
                joint_index
            )
        state_array = np.asarray(
            state,
            dtype=np.float32,
        )
        state_tensor = torch.as_tensor(
            state_array,
            dtype=torch.float32,
            device=self.device,
        ).unsqueeze(0)
        with torch.no_grad():
            q_values = (
                self.policy_network
                .action_values(
                    state_tensor
                )
            )
        # Expected output:
        # [1,125]
        if q_values.ndim != 2:
            raise RuntimeError(
                f"Invalid DQN output shape {q_values.shape}"
            )
        # ==================================================
        # PHASE 4.2 COLLISION SAFE ACTION SELECTION
        # ==================================================
        ranked_actions = torch.argsort(
            q_values[0],
            descending=True
        )
        for idx in ranked_actions:
            joint_id=int(idx.item())
            candidate=self.decode_joint_action(
                joint_id
            )
            if self.check_collision_free(
                candidate
            ):
                return candidate
        return self.decode_joint_action(
            int(ranked_actions[0].item())
        )
    def check_collision_free(
        self,
        actions
    ):
        if self._evaluation_env is None:
            return True
        env=self._evaluation_env
        predicted=[]
        movement={
            0:(0,0),
            1:(1,0),
            2:(-1,0),
            3:(0,1),
            4:(0,-1)
        }
        for i,action in enumerate(actions):
            agv=env.system.agvs[i+1]
            x,y=agv.position
            dx,dy=movement[int(action)]
            predicted.append(
                (
                    x+dx,
                    y+dy
                )
            )
        # same target cell collision
        if len(predicted)!=len(set(predicted)):
            return False
        # swap collision
        for i in range(len(predicted)):
            for j in range(i+1,len(predicted)):
                if (
                    tuple(env.system.agvs[i+1].position)
                    ==
                    predicted[j]
                    and
                    tuple(env.system.agvs[j+1].position)
                    ==
                    predicted[i]
                ):
                    return False
        return True
    # ======================================================
    # STORE EXPERIENCE
    # ======================================================

    def remember(
        self,
        state,
        action,
        reward,
        next_state,
        done,
    ):

        self.replay_buffer.add(
            state,
            action,
            reward,
            next_state,
            done,
        )

        # ======================================================
    # TRAIN
    # ======================================================

        # ======================================================
    # TRAIN
    # ======================================================

    def train_step(self):

        if len(
            self.replay_buffer
        ) < self.batch_size:

            return None

        (
            states,
            actions,
            rewards,
            next_states,
            dones,
        ) = self.replay_buffer.sample(
            self.batch_size
        )

        states_tensor = torch.as_tensor(
            states,
            dtype=torch.float32,
            device=self.device,
        )

        actions_tensor = torch.as_tensor(
            actions,
            dtype=torch.long,
            device=self.device,
        )

        rewards_tensor = torch.as_tensor(
            rewards,
            dtype=torch.float32,
            device=self.device,
        )

        next_states_tensor = torch.as_tensor(
            next_states,
            dtype=torch.float32,
            device=self.device,
        )

        dones_tensor = torch.as_tensor(
            dones,
            dtype=torch.float32,
            device=self.device,
        )

        # ==================================================
        # VALIDATE ACTION SHAPE
        # ==================================================

        if actions_tensor.ndim == 1:

            actions_tensor = (
                actions_tensor
                .reshape(
                    self.batch_size,
                    self.num_agvs,
                )
            )

        if actions_tensor.shape != (
            self.batch_size,
            self.num_agvs,
        ):

            raise RuntimeError(
                "Invalid action tensor shape: "
                f"{actions_tensor.shape}. "
                f"Expected "
                f"({self.batch_size}, "
                f"{self.num_agvs})"
            )

        # ==================================================
        # ENCODE INDIVIDUAL AGV ACTIONS
        # INTO ONE JOINT ACTION
        # ==================================================

        joint_actions = []

        for action_row in actions_tensor:

            joint_index = 0

            for action in action_row:

                joint_index = (
                    joint_index
                    * self.action_size
                    + int(action.item())
                )

            joint_actions.append(
                joint_index
            )

        joint_actions_tensor = torch.as_tensor(
            joint_actions,
            dtype=torch.long,
            device=self.device,
        )

        # ==================================================
        # CURRENT Q VALUES
        # ==================================================

        current_q = (
            self.policy_network.action_values(
                states_tensor
            )
        )

        # Expected:
        #
        # [batch_size, 125]
        #

        if current_q.ndim != 2:

            raise RuntimeError(
                "Invalid current Q shape: "
                f"{current_q.shape}. "
                "Expected [batch, joint_action_size]."
            )

        if current_q.shape[1] != (
            self.joint_action_size
        ):

            raise RuntimeError(
                "Invalid current Q action dimension: "
                f"{current_q.shape}. "
                f"Expected second dimension "
                f"{self.joint_action_size}."
            )

        # ==================================================
        # Q VALUE OF ACTION ACTUALLY TAKEN
        # ==================================================

        chosen_q = (
            current_q
            .gather(
                1,
                joint_actions_tensor.unsqueeze(1),
            )
            .squeeze(1)
        )

        # ==================================================
        # TARGET Q VALUES
        # ==================================================

        with torch.no_grad():

            next_q = (
                self.target_network.action_values(
                    next_states_tensor
                )
            )

            # Expected:
            #
            # [batch_size, 125]
            #

            if next_q.ndim != 2:

                raise RuntimeError(
                    "Invalid next Q shape: "
                    f"{next_q.shape}. "
                    "Expected [batch, joint_action_size]."
                )

            max_next_q = (
                next_q
                .max(
                    dim=1
                )
                .values
            )

            # ==================================================
            # BELLMAN TARGET
            # ==================================================

            target_q = (
                rewards_tensor
                +
                self.gamma
                * max_next_q
                * (
                    1.0
                    -
                    dones_tensor
                )
            )

        # ==================================================
        # HUBER LOSS
        # ==================================================

        loss = self.loss_function(
            chosen_q,
            target_q,
        )

        # ==================================================
        # BACKPROPAGATION
        # ==================================================

        self.optimizer.zero_grad()

        loss.backward()

        # ==================================================
        # GRADIENT CLIPPING
        # ==================================================

        torch.nn.utils.clip_grad_norm_(
            self.policy_network.parameters(),
            max_norm=1.0,
        )

        self.optimizer.step()

        self.training_steps += 1

        # ==================================================
        # SOFT TARGET UPDATE
        # ==================================================

        self.soft_update()

        return float(
            loss.item()
        )
    # ======================================================
    # SOFT UPDATE
    # ======================================================

    def soft_update(self):

        with torch.no_grad():

            for target_param, policy_param in zip(
                self.target_network.parameters(),
                self.policy_network.parameters(),
            ):

                target_param.data.mul_(
                    1.0 - self.tau
                )

                target_param.data.add_(
                    self.tau
                    *
                    policy_param.data
                )

    # ======================================================
    # EPSILON DECAY
    # ======================================================

    def decay_epsilon(self):

        self.epsilon = max(
            self.epsilon_min,
            self.epsilon
            *
            self.epsilon_decay,
        )

    # ======================================================
    # EVALUATION MODE
    # ======================================================

    def evaluation_mode(self):
    
     self._evaluation_epsilon = self.epsilon

     self.policy_network.eval()
     self.target_network.eval()

     self.epsilon = 0.0

    # ======================================================
    # TRAINING MODE
    # ======================================================

    def training_mode(self):
    

     self.policy_network.train()
     self.target_network.eval()

     if hasattr(
        self,
        "_evaluation_epsilon",
    ):

        self.epsilon = (
            self._evaluation_epsilon
        )

        del self._evaluation_epsilon

    # ======================================================
    # SAVE
    # ======================================================

    def save(
        self,
        filepath,
    ):

        torch.save(
            {
                "policy_network":
                    self.policy_network.state_dict(),

                "target_network":
                    self.target_network.state_dict(),

                "optimizer":
                    self.optimizer.state_dict(),

                "epsilon":
                    self.epsilon,

                "training_steps":
                    self.training_steps,

                "state_size":
                    self.state_size,

                "num_agvs":
                    self.num_agvs,

                "action_size":
                    self.action_size,
            },
            filepath,
        )

    # ======================================================
    # LOAD
    # ======================================================

    def load(
        self,
        filepath,
    ):

        checkpoint = torch.load(
            filepath,
            map_location=self.device,
        )

        self.policy_network.load_state_dict(
            checkpoint[
                "policy_network"
            ]
        )

        self.target_network.load_state_dict(
            checkpoint[
                "target_network"
            ]
        )

        if "optimizer" in checkpoint:

            self.optimizer.load_state_dict(
                checkpoint[
                    "optimizer"
                ]
            )

        self.epsilon = float(
            checkpoint.get(
                "epsilon",
                self.epsilon,
            )
        )

        self.training_steps = int(
            checkpoint.get(
                "training_steps",
                0,
            )
        )


__all__ = [
    "DQNAgent",
]
